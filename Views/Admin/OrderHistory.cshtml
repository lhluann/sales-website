@model IEnumerable<HL.store.Models.OrderHistoryViewModel>
@{
    ViewBag.Title = "Lịch Sử Mua Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">

    <h3 class="text-center mb-3">Lịch Sử Mua Hàng</h3>

    <table class="table table-bordered table-hover bg-white">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Ngày</th>
                <th>Khách hàng</th>
                <th>Sản phẩm</th>
                <th class="text-end">Tổng tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.OrderID</td>
                    <td>@o.DateOrder</td>

                    <td>
                        <b>@o.CustomerName</b><br />
                        <small>@o.CustomerPhone</small><br />
                        <small>@o.CustomerEmail</small>
                    </td>

                    <td>@Html.Raw(o.ProductList)</td>

                    <td class="text-end text-danger fw-bold">
                        @o.TotalAmount.ToString("N0") VNĐ
                    </td>
                    <td>
                        <a href="@Url.Action("Trangchu", "Chitietsanpham")" class="submit-btn inline-flex items-center justify-center w-full p-3 bg-blue-500 text-white rounded hover:bg-blue-600 transition">
                            <i class="fa-solid fa-paper-plane mr-2"></i> Send
                        </a>
                    </td>
                </tr>

                
            }
        </tbody>
    </table>

</div>

<style>
    body {
        background: #f5f5f5;
    }

    tr:hover {
        background: #eef6ff;
    }
</style>