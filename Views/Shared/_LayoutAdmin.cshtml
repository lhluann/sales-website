<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/Content/mystyle/style1.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/js/all.min.js"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/js/all.min.js"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/js/all.min.js"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/js/all.min.js"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/js/all.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Satisfy&display=swap" rel="stylesheet">
    <style>
        body {  
        }
        .nav {
            width: 100%;
            height: 100px;
            background-color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;     
            position: sticky;
            z-index: 1000;
            margin-top:-20px;
        }

        #fm-brand h2 {
            font-family: 'Dancing Script', cursive;
            font-size: 28px;
            margin: 0;
            color: #007bff;
        }

        #fm-menu {
            display: flex;
            gap: 15px;
            padding: 0;
            margin: 0;
            list-style: none;
        }

            #fm-menu li {
                padding: 12px 25px;
                border-radius: 25px;
                transition: 0.3s;
            }

                #fm-menu li a {
                    text-decoration: none;
                    color: #222;
                    font-weight: 600;
                }

                #fm-menu li:hover {
                    background-color: #007bff;
                }

                    #fm-menu li:hover a {
                        color: #fff;
                    }
        .nav-bar-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }

            .nav-bar-right input[name="keyword"] {
                height: 38px;
                padding: 0 15px 0 40px;
                border-radius: 50px;
                border: 2px solid #007bff;
                transition: all 0.3s;
            }

                .nav-bar-right input[name="keyword"]:focus {
                    outline: none;
                    box-shadow: 0 0 8px rgba(0,123,255,0.4);
                }
        .cart-icon, .user-icon {
            font-size: 1.5rem;
            cursor: pointer;
            transition: all 0.3s;
            color: #007bff;
            position: relative;
        }

            .cart-icon:hover {
                transform: scale(1.2);
                color: #ffa500;
            }

            .user-icon:hover {
                transform: scale(1.2);
                color: #0056b3;
            }
            .cart-icon .badge {
                position: absolute;
                top: -5px;
                right: -5px;
                background: #dc3545;
                color: #fff;
                font-size: 0.7rem;
                padding: 2px 6px;
                border-radius: 50%;
            }
        .container-orders {
            max-width: 1200px;
            margin: 30px auto;
            background: #fff;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95rem;
        }

            table th, table td {
                padding: 12px 15px;
                vertical-align: middle;
            }

            table thead {
                background-color: #007bff;
                color: #fff;
                text-align: left;
                border-radius: 15px;
            }

            table tbody tr {
                transition: 0.3s;
            }

                table tbody tr:hover {
                    background-color: #e3f2fd;
                }

        .text-end {
            text-align: right;
        }

        .text-danger {
            color: #dc3545;
            font-weight: 600;
        }

    </style>
</head>
<body>
    <div class="nav">
        <div id="fm-brand">
            <h2 class="dancing-script-uniquifier">HL Store</h2>
        </div>
        <div class="nav-bar-menu">
            <div  id="menu">
                <ol id="fm-menu">
                    <li><a href="/trangchu/Home"><b>Home</b></a></li>
                    <li><a href="/trangchu/Contact"><b>Contact</b></a></li>
                    <li><a href="/trangchu/Product"><b>Product</b></a></li>
                    <li><a href="/trangchu/Service"><b>Service</b></a></li>

                </ol>
            </div>
        </div>
        <div class="nav-bar-right">
            <div>
                <form action="/trangchu/Product" method="get" id="globalSearchForm">
                    <div style="position:relative;">
                        <i class="fas fa-search" style="position:absolute; left:20px; top:50%; transform:translateY(-50%); color:#007bff; font-size:20px; "></i>
                        <input type="text" name="keyword" value="@(Request["keyword"] ?? "")" placeholder="Search..." style=" height:40px; padding:0 40px 0 50px; border:3px solid #007bff; border-radius:50px;   " />
                    </div>
                </form>
            </div>
            <a href="/Admin/OrderHistory" class="cart-icon" title="Lịch sử mua hàng">
                <i class="fas fa-clock-rotate-left"></i>
            </a>

            @if (Session["NameUser"] != null)
            {
                <span style="margin-left: 10px; font-weight:bold; color:#007bff;">
                    Xin chào, @Session["NameUser"]
                </span>
                <a href="@Url.Action("Logout", "LoginRegister")" class="user-icon" title="Đăng xuất">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            }
            else
            {
                <a href="@Url.Action("IndexLoginRegister", "LoginRegister")" class="user-icon" title="Tài khoản">
                    <i class="fas fa-circle-user"></i>
                </a>
            }
        </div>
</div>
    
    <div class="grid-container" id="grid">
        <div class="left-side">

        </div>
        <div class="right-side">
            @RenderBody()
            
        </div>
    </div>
    
</body>
</html>
