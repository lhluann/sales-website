@model IEnumerable<HL.store.Models.Product1>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
        
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {

        }
        .container {
            max-width: 1300px;
            margin: 30px auto;
            
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 50px rgba(0,0,0,0.1);
            margin-top:10px;
        }

        .header {
            background-color: dodgerblue;
            color: white;
            padding: 30px;
            text-align: center;
        }

        .action-bar {
            padding: 25px;
            background: #f8f9fa;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;

        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>QUẢN LÝ SẢN PHẨM</h1>
        </div>

        <div class="action-bar">
            <a href="@Url.Action("Create", "Product")" class="btn btn-success btn-lg">Add New</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }

        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#ID</th>
                    <th>Hình</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá</th>
                    <th>Danh mục</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong>#@p.ProductID</strong></td>
                        <td>
                            <img src="@(string.IsNullOrEmpty(p.ImagePro) ? "~/Hinh/no-image.jpg" : Url.Content(p.ImagePro))"
                                 width="80" height="80" style="object-fit:cover; border-radius:10px;" />
                        </td>
                        <td><strong>@p.NamePro</strong></td>
                        <td class="text-danger fw-bold">@String.Format("{0:N0}", p.Price) ₫</td>
                        <td>@(ViewBag.CategoryNames != null && ViewBag.CategoryNames[p.ProductID] != null ? ViewBag.CategoryNames[p.ProductID] : "Chưa chọn")</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = p.ProductID })" class="btn btn-warning btn-sm">Edit</a>
                            <a href="@Url.Action("Delete", new { id = p.ProductID })" class="btn btn-danger btn-sm"
                               onclick="return confirm('Xóa sản phẩm @p.NamePro ?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>